rt":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"xUpVg9bgQi"}],"key":"JQmQnowGwY"},{"type":"heading","depth":2,"position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"children":[{"type":"text","value":"中文","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"key":"KHKpxyRdc5"}],"identifier":"id","label":"中文","html_id":"id","implicit":true,"key":"gDiw8CNZ8N"},{"type":"heading","depth":3,"position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"children":[{"type":"text","value":"插入图片","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"cd8yeWWqk9"}],"identifier":"id","label":"插入图片","html_id":"id-1","implicit":true,"key":"Q5il2hJBI5"},{"type":"paragraph","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"children":[{"type":"text","value":"在 Edit 模式点击格式工具栏上方的 Insert image。支持 PNG、JPEG、GIF、WebP，每张不超过 20 MB。也可以将图片拖入编辑区，或从剪贴板粘贴截图；普通文字粘贴仍正常工作。","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"izuIonsyQD"}],"key":"MP000DGLbo"},{"type":"paragraph","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"children":[{"type":"text","value":"图片会复制到 Data Location 所示的数据目录，正文光标处插入 Markdown 图片引用。修改方括号内文字可调整图片描述，切换 Preview 查看本地副本。移动或删除原文件不会影响已导入的图片。","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"key":"L9NpWmwDEh"}],"key":"Gzl4dXBeAX"},{"type":"heading","depth":3,"position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"children":[{"type":"text","value":"复用与检查","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"key":"Q2L5xNSRmR"}],"identifier":"id","label":"复用与检查","html_id":"id-2","implicit":true,"key":"fri7H8BQ8H"},{"type":"paragraph","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"children":[{"type":"text","value":"打开 Resources，找到文件后点击 Insert。相同内容复用一份资源，不同内容即使文件名相同也会分别保存。撤销插入只移除正文引用，资源仍保留供复用。","position":{"start":{"line":30,"co