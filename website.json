{"version":3,"kind":"Article","sha256":"e6df45fd717cb7c40cf9a9602d14399b0d9f808bc859e60439d3ec8fa57d503b","slug":"website","location":"/guide/phase-4/website.md","dependencies":[],"frontmatter":{"title":"Local Website","label":"lancarbon-phase4-website","authors":[{"nameParsed":{"literal":"Haojie Dai","given":"Haojie","family":"Dai"},"name":"Haojie Dai","id":"contributors-Users\\HAOJIE~1\\AppData\\Local\\Temp\\lancarbon-pages-build-V8URAy\\myst-generated-uid-0"}],"license":{"content":{"id":"CC-BY-4.0","url":"https://creativecommons.org/licenses/by/4.0/","name":"Creative Commons Attribution 4.0 International","free":true,"CC":true}},"github":"https://github.com/Hao-jieDai/LanCarbon-Guide","keywords":["LanCarbon","Jupyter Book","MyST","Markdown"],"numbering":{"title":{"offset":1}},"exports":[{"format":"md","filename":"website.md","url":"/LanCarbon-Guide/build/website-c70c6e5a607be794e9fce7f71634ec0e.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"heading","depth":2,"position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"text","value":"English","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"zlYIdN6uzl"}],"identifier":"english","label":"English","html_id":"english","implicit":true,"key":"uTDhx6jDaX"},{"type":"heading","depth":3,"position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"text","value":"Start, open and stop","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"GEukUyhCw5"}],"identifier":"start-open-and-stop","label":"Start, open and stop","html_id":"start-open-and-stop","implicit":true,"key":"pjtmwRZIha"},{"type":"paragraph","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"children":[{"type":"text","value":"A successful Build starts the saved website automatically. Select its 127.0.0.1 address or Open Website to open it in your normal browser. LanCarbon chooses a free port, so an existing service on port 3000 is not interrupted. Only this computer can reach the address.","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"key":"wFLaXA3Opy"}],"key":"hPHZ90Z1z9"},{"type":"paragraph","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"children":[{"type":"text","value":"Stop Website ends the local service without deleting the build. Start Website serves the same saved _build/html again without rebuilding. After restarting LanCarbon, open Build and select Start Website to restore an address for the last successful build.","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"key":"ZkYA8rkWVy"}],"key":"wztx7Z1X34"},{"type":"paragraph","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"children":[{"type":"text","value":"Rebuilding keeps the previous website available until the new strict build succeeds. The local address is a viewing service, while the managed build folder is the durable copy. Closing LanCarbon stops its website services; it does not delete the saved files.","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"key":"ySFmQAe5RI"}],"key":"f85VFRHvJJ"},{"type":"heading","depth":2,"position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"children":[{"type":"text","value":"中文","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"key":"SB2CrtvLnR"}],"identifier":"id","label":"中文","html_id":"id","implicit":true,"key":"IRyqkhc45B"},{"type":"heading","depth":3,"position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"children":[{"type":"text","value":"启动、打开与停止","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"s4wJx9wgOi"}],"identifier":"id","label":"启动、打开与停止","html_id":"id-1","implicit":true,"key":"wtOITHgBB0"},{"type":"paragraph","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"children":[{"type":"text","value":"Build 成功后会自动启动已保存的网站。点击 127.0.0.1 地址或 Open Website，可在默认浏览器中打开。LanCarbon 自动选择空闲端口，不会中断已经占用 3000 端口的服务；该地址只能由当前电脑访问。","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"key":"ultfJgaEVl"}],"key":"XErG8sjIC4"},{"type":"paragraph","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"children":[{"type":"text","value":"Stop Website 只停止本地服务，不删除构建结果。Start Website 可以直接重新提供同一份 _build/html，无需再次构建。重启 LanCarbon 后，打开 Build 并点击 Start Website，即可为上一次成功构建恢复网址。","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"RVuL6mGhN0"}],"key":"cfsuF4lXEZ"},{"type":"paragraph","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"children":[{"type":"text","value":"重新构建时，上一次网站会保留到新的严格构建成功为止。本地网址用于查看，受管理构建文件夹才是长期保存的副本。关闭 LanCarbon 会停止由它启动的网站服务，但不会删除保存的文件。","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"HoHR7vKg0X"}],"key":"fEGONcUrDh"}],"key":"l6FgdB1Pxc"}],"key":"Q6JI0HHhKe"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Build and Saved Website","url":"/build","group":"LanCarbon Guide"},"next":{"title":"Phase 4 Acceptance","url":"/acceptance-1","group":"LanCarbon Guide"}}},"domain":"http://localhost:3000"}