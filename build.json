{"version":3,"kind":"Article","sha256":"4aae46656ffbee325332838083d35b3b9a1f95400e769b86700bfe9560a73219","slug":"build","location":"/guide/phase-4/build.md","dependencies":[],"frontmatter":{"title":"Build and Saved Website","label":"lancarbon-phase4-build","authors":[{"nameParsed":{"literal":"Haojie Dai","given":"Haojie","family":"Dai"},"name":"Haojie Dai","id":"contributors-Users\\HAOJIE~1\\AppData\\Local\\Temp\\lancarbon-pages-build-6WYntt\\myst-generated-uid-0"}],"license":{"content":{"id":"CC-BY-4.0","url":"https://creativecommons.org/licenses/by/4.0/","name":"Creative Commons Attribution 4.0 International","free":true,"CC":true}},"github":"https://github.com/Hao-jieDai/LanCarbon-Guide","keywords":["LanCarbon","Jupyter Book","MyST","Markdown"],"numbering":{"title":{"offset":1}},"exports":[{"format":"md","filename":"build.md","url":"/LanCarbon-Guide/build/build-b4f24e16c37614ff6e1df933fddb7876.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"heading","depth":2,"position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"text","value":"Build inside LanCarbon","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"AEpP5BIntl"}],"identifier":"build-inside-lancarbon","label":"Build inside LanCarbon","html_id":"build-inside-lancarbon","implicit":true,"key":"asDurTRzPO"},{"type":"paragraph","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"text","value":"After preflight passes, choose a parent folder. LanCarbon creates one managed subfolder named ","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"cYmQtmIxOZ"},{"type":"inlineCode","value":"Book Title-Built","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"s0qowzBuoe"},{"type":"text","value":", exports the current source and resources there, and runs:","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"wQMf6ludJV"}],"key":"jYkmMnk6Ps"},{"type":"code","lang":"","value":"jupyter book build --html --strict --ci","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"key":"Ec0ohNe22Q"},{"type":"paragraph","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"children":[{"type":"text","value":"Jupyter Book 2 must be installed and the jupyter command must be available in PATH. The build panel shows completion time, saved HTML path, CLI diagnostics and the full command output when available.","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"Lrhf9KsNKe"}],"key":"VCZsMdOBYi"},{"type":"heading","depth":2,"position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"text","value":"Safe rebuilds and saved output","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"ojuZpwfCTq"}],"identifier":"safe-rebuilds-and-saved-output","label":"Safe rebuilds and saved output","html_id":"safe-rebuilds-and-saved-output","implicit":true,"key":"eCe5Qx9SV8"},{"type":"paragraph","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"children":[{"type":"text","value":"A rebuild is prepared in a temporary sibling folder. Only after Jupyter Book creates _build/html/index.html does LanCarbon replace the previous managed build. A failed build removes its temporary files and leaves the last successful website intact. LanCarbon refuses to replace a folder that does not carry the matching managed-build marker.","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"A8VcZ3TDoc"}],"key":"B7bsF24Bpm"},{"type":"paragraph","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"children":[{"type":"text","value":"After a successful Build, the result panel shows a local 127.0.0.1 website address and an Open Website button. The address works while LanCarbon is running. Open Build Folder to inspect the source project and _build/html; these files remain on disk after LanCarbon and PowerShell close.","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"eBL8ApWOPx"}],"key":"zFmlhBbIIU"},{"type":"heading","depth":2,"position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"children":[{"type":"text","value":"在 LanCarbon 内构建","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"key":"AFKsKtm62g"}],"identifier":"id-lancarbon","label":"在 LanCarbon 内构建","html_id":"id-lancarbon","implicit":true,"key":"YaNoEXh6Zx"},{"type":"paragraph","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"children":[{"type":"text","value":"预检通过后选择一个父目录。LanCarbon 会创建名为 ","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"key":"UiukzBuM2Y"},{"type":"inlineCode","value":"Book 标题-Built","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"key":"igGdADARke"},{"type":"text","value":" 的受管理子目录，把当前正文及资源导出到其中，并运行：","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"key":"gNIkBlgBF6"}],"key":"jh0RqgHirn"},{"type":"code","lang":"","value":"jupyter book build --html --strict --ci","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"key":"Ev8bTUfADL"},{"type":"paragraph","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"children":[{"type":"text","value":"电脑需要安装 Jupyter Book 2，并能通过 PATH 找到 jupyter 命令。构建面板显示耗时、HTML 保存路径、CLI 诊断，并在可用时提供完整命令输出。","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"key":"qYnhX2gvqp"}],"key":"eQXRIwJclq"},{"type":"heading","depth":2,"position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"children":[{"type":"text","value":"安全重建与长期保存","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"key":"PAq3tBmWTN"}],"identifier":"id","label":"安全重建与长期保存","html_id":"id","implicit":true,"key":"UWzBOzJOnu"},{"type":"paragraph","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"children":[{"type":"text","value":"重新构建先在同级临时目录完成。只有 Jupyter Book 成功生成 _build/html/index.html 后，LanCarbon 才替换上一次受管理构建。失败时清理临时文件，保留上一次成功网站。没有匹配管理标记的目录不会被覆盖。","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"YeS2ROubOa"}],"key":"KAKeSHygHM"},{"type":"paragraph","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"children":[{"type":"text","value":"Build 成功后，结果面板会显示本地 127.0.0.1 网站地址和 Open Website 按钮；该地址在 LanCarbon 运行期间有效。点击 Open Build Folder 可查看导出源文件和 _build/html，关闭 LanCarbon 或 PowerShell 后这些文件仍会保留。","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"HTBlexhFZh"}],"key":"GoQSeDdr2q"},{"type":"comment","value":" lancarbon-offline-theme-runtime-1 ","key":"D9CxCqwmzW"},{"type":"heading","depth":2,"position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"children":[{"type":"text","value":"Bundled Book Theme","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"key":"F1KOWfdueU"}],"identifier":"bundled-book-theme","label":"Bundled Book Theme","html_id":"bundled-book-theme","implicit":true,"key":"iWHzHC9m9b"},{"type":"paragraph","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"children":[{"type":"text","value":"LanCarbon includes a verified official Book Theme runtime snapshot. The first Build prepares it in LanCarbon’s persistent cache; later builds reuse that cache instead of downloading the template from GitHub. The installed Jupyter Book 2 command is still responsible for parsing and building the Book.","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"key":"RZqNm6r6of"}],"key":"r6UUNN6hfY"},{"type":"paragraph","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"children":[{"type":"text","value":"After a build, LanCarbon closes only the temporary theme service created for that build. A local website that was already running, including one on port 3000, is left intact.","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"key":"CWLVxo6TOM"}],"key":"PGEFhgcAbY"},{"type":"heading","depth":2,"position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"children":[{"type":"text","value":"内置 Book Theme","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"key":"tp4ra1An9N"}],"identifier":"id-book-theme","label":"内置 Book Theme","html_id":"id-book-theme","implicit":true,"key":"h7TS8Z2cml"},{"type":"paragraph","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"children":[{"type":"text","value":"LanCarbon 附带经过验证的官方 Book Theme 运行时快照。第一次 Build 会在软件的持久缓存中准备该运行时，后续构建直接复用，不再从 GitHub 下载模板。本机安装的 Jupyter Book 2 命令仍负责解析并构建 Book。","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"key":"msxNiPwLvI"}],"key":"nhc5gAams3"},{"type":"paragraph","position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"children":[{"type":"text","value":"构建结束后，LanCarbon 只关闭本次构建创建的临时主题服务；原本已经运行的本地网站（包括 3000 端口上的服务）不会被关闭。","position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"key":"z7ODVca20L"}],"key":"HY3jx9Qt7P"}],"key":"oMfP8ybswj"}],"key":"iDrU5sUyb4"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Book Preflight","url":"/preflight","group":"LanCarbon Guide"},"next":{"title":"Local Website","url":"/website","group":"LanCarbon Guide"}}},"domain":"http://localhost:3000"}