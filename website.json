{"version":3,"kind":"Article","sha256":"d5847e39dfd6ba23bd7cc3df611c35a515bc5af8c5228b711b6ea12b7281e345","slug":"website","location":"/guide/phase-4/website.md","dependencies":[],"frontmatter":{"title":"Local Website","label":"lancarbon-phase4-website","authors":[{"nameParsed":{"literal":"Haojie Dai","given":"Haojie","family":"Dai"},"name":"Haojie Dai","id":"contributors-Users\\HAOJIE~1\\AppData\\Local\\Temp\\lancarbon-pages-build-6WYntt\\myst-generated-uid-0"}],"license":{"content":{"id":"CC-BY-4.0","url":"https://creativecommons.org/licenses/by/4.0/","name":"Creative Commons Attribution 4.0 International","free":true,"CC":true}},"github":"https://github.com/Hao-jieDai/LanCarbon-Guide","keywords":["LanCarbon","Jupyter Book","MyST","Markdown"],"numbering":{"title":{"offset":1}},"exports":[{"format":"md","filename":"website.md","url":"/LanCarbon-Guide/build/website-e9a87d94b779ded49014fae572567b6c.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"heading","depth":2,"position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"text","value":"Start, open and stop","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"V4swlNpkt6"}],"identifier":"start-open-and-stop","label":"Start, open and stop","html_id":"start-open-and-stop","implicit":true,"key":"RACSYgL3ZK"},{"type":"paragraph","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"text","value":"A successful Build starts the saved website automatically. Select its 127.0.0.1 address or Open Website to open it in your normal browser. LanCarbon chooses a free port, so an existing service on port 3000 is not interrupted. Only this computer can reach the address.","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"z5f07fkWk9"}],"key":"oGmxtB3kjG"},{"type":"paragraph","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"children":[{"type":"text","value":"Stop Website ends the local service without deleting the build. Start Website serves the same saved _build/html again without rebuilding. After restarting LanCarbon, open Build and select Start Website to restore an address for the last successful build.","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"key":"rDj6dpuY0b"}],"key":"Zp2HL0TuvQ"},{"type":"paragraph","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"children":[{"type":"text","value":"Rebuilding keeps the previous website available until the new strict build succeeds. The local address is a viewing service, while the managed build folder is the durable copy. Closing LanCarbon stops its website services; it does not delete the saved files.","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"HoE0KIg5WS"}],"key":"zu5h7JwNF3"},{"type":"heading","depth":2,"position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"children":[{"type":"text","value":"启动、打开与停止","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"PAkWrPXgZT"}],"identifier":"id","label":"启动、打开与停止","html_id":"id","implicit":true,"key":"PcdszBgeaA"},{"type":"paragraph","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"children":[{"type":"text","value":"Build 成功后会自动启动已保存的网站。点击 127.0.0.1 地址或 Open Website，可在默认浏览器中打开。LanCarbon 自动选择空闲端口，不会中断已经占用 3000 端口的服务；该地址只能由当前电脑访问。","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"pMAcosLmJf"}],"key":"E91w5EOmva"},{"type":"paragraph","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"children":[{"type":"text","value":"Stop Website 只停止本地服务，不删除构建结果。Start Website 可以直接重新提供同一份 _build/html，无需再次构建。重启 LanCarbon 后，打开 Build 并点击 Start Website，即可为上一次成功构建恢复网址。","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"Q7UrDtmJnN"}],"key":"QpYMR5kEsq"},{"type":"paragraph","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"children":[{"type":"text","value":"重新构建时，上一次网站会保留到新的严格构建成功为止。本地网址用于查看，受管理构建文件夹才是长期保存的副本。关闭 LanCarbon 会停止由它启动的网站服务，但不会删除保存的文件。","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"key":"Ag2mzX1OGw"}],"key":"zp1frMlvKt"}],"key":"sNIztL0ToP"}],"key":"ehIqmEhfU0"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Build and Saved Website","url":"/build","group":"LanCarbon Guide"},"next":{"title":"Phase 4 Acceptance","url":"/acceptance-1","group":"LanCarbon Guide"}}},"domain":"http://localhost:3000"}