{"version":3,"kind":"Article","sha256":"1cee5ae4dfbe0642a28c96b74d235fa5e74d1b26c061c4043f9a872544719d79","slug":"readiness","location":"/guide/phase-5/readiness.md","dependencies":[],"frontmatter":{"title":"Publishing Readiness","label":"lancarbon-phase5-readiness","authors":[{"nameParsed":{"literal":"Haojie Dai","given":"Haojie","family":"Dai"},"name":"Haojie Dai","id":"contributors-Users\\HAOJIE~1\\AppData\\Local\\Temp\\lancarbon-pages-build-3Z9fzA\\myst-generated-uid-0"}],"license":{"content":{"id":"CC-BY-4.0","url":"https://creativecommons.org/licenses/by/4.0/","name":"Creative Commons Attribution 4.0 International","free":true,"CC":true}},"github":"https://github.com/Hao-jieDai/LanCarbon-Guide","keywords":["LanCarbon","Jupyter Book","MyST","Markdown"],"numbering":{"title":{"offset":1}},"exports":[{"format":"md","filename":"readiness.md","url":"/LanCarbon-Guide/build/readiness-00c6dfcba6c27f20b22091a7c5a333c2.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"heading","depth":2,"position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"text","value":"English","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"lSLjrEASni"}],"identifier":"english","label":"English","html_id":"english","implicit":true,"key":"RybnywMymh"},{"type":"heading","depth":3,"position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"text","value":"Phase 5A checks","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"swQtCsoRFp"}],"identifier":"phase-5a-checks","label":"Phase 5A checks","html_id":"phase-5a-checks","implicit":true,"key":"h17cwqPhYJ"},{"type":"paragraph","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"children":[{"type":"text","value":"Open a Book and choose Publish. LanCarbon checks Git, GitHub CLI, GitHub authentication, the most recent managed Book build, the saved repository binding and GitHub Pages. Each result is shown as passed, warning or error.","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"key":"kAzZvxQF2J"}],"key":"EtshakCUKJ"},{"type":"paragraph","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"children":[{"type":"text","value":"Git and GitHub CLI must be available in PATH. LanCarbon uses the account already authenticated by GitHub CLI and does not store a GitHub password or access token in notes.json. If GitHub CLI is missing, use Open GitHub CLI Download. If it is installed but signed out, use Sign in with GitHub CLI, finish authentication in the visible terminal, then select Refresh Checks.","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"key":"zBPbkmFePz"}],"key":"yD8OHzkLTg"},{"type":"paragraph","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"children":[{"type":"text","value":"A successful Book build is recommended now and required before Phase 5C publishes the real website. It does not block repository setup because Phase 5B prepares the remote destination without uploading Book files.","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"key":"in0BVxc0xu"}],"key":"CdSiwLaBwU"},{"type":"heading","depth":2,"position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"children":[{"type":"text","value":"中文","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"key":"xEe4r1bV6m"}],"identifier":"id","label":"中文","html_id":"id","implicit":true,"key":"thj5p6bUOO"},{"type":"heading","depth":3,"position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"children":[{"type":"text","value":"Phase 5A 检查","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"mT5CftgBpm"}],"identifier":"phase-5a","label":"Phase 5A 检查","html_id":"phase-5a","implicit":true,"key":"KYhprIKrkb"},{"type":"paragraph","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"children":[{"type":"text","value":"打开一本 Book 并点击 Publish。LanCarbon 会检查 Git、GitHub CLI、GitHub 登录状态、最近一次受管理构建、已保存的仓库绑定以及 GitHub Pages，并将结果显示为通过、警告或错误。","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"key":"CX2VbaI6CL"}],"key":"bRFC6rWrtn"},{"type":"paragraph","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"children":[{"type":"text","value":"Git 与 GitHub CLI 必须能够通过 PATH 找到。LanCarbon 使用 GitHub CLI 已登录的账户，不会把 GitHub 密码或访问令牌写入 notes.json。GitHub CLI 缺失时点击 Open GitHub CLI Download；已经安装但未登录时点击 Sign in with GitHub CLI，在可见终端中完成认证，再点击 Refresh Checks。","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"p9Ao7FGz2F"}],"key":"yQMFtlZnke"},{"type":"paragraph","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"children":[{"type":"text","value":"建议先完成一次 Book Build；Phase 5C 发布真实网站前必须存在成功构建。Phase 5B 只准备远端目标，不上传 Book 文件，因此构建缺失在当前阶段只显示警告。","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"ZC0rPN4pXD"}],"key":"yhal2aKzoW"}],"key":"F5B8O9i7oX"}],"key":"BGnNVUWroZ"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Phase 5 Reference","url":"/index-6","group":"LanCarbon Guide"},"next":{"title":"GitHub and Pages Setup","url":"/github-pages","group":"LanCarbon Guide"}}},"domain":"http://localhost:3002"}