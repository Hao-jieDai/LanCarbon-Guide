line":30,"column":1}},"children":[{"type":"text","value":"电脑需要安装 Jupyter Book 2，并能通过 PATH 找到 jupyter 命令。构建面板显示耗时、HTML 保存路径、CLI 诊断，并在可用时提供完整命令输出。","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"key":"Djj08AvZcJ"}],"key":"E4Q7Wiecyy"},{"type":"heading","depth":3,"position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"children":[{"type":"text","value":"安全重建与长期保存","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"key":"RK3mdHfHyv"}],"identifier":"id","label":"安全重建与长期保存","html_id":"id-1","implicit":true,"key":"C2lhJmVpeF"},{"type":"paragraph","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"children":[{"type":"text","value":"重新构建先在同级临时目录完成。只有 Jupyter Book 成功生成 _build/html/index.html 后，LanCarbon 才替换上一次受管理构建。失败时清理临时文件，保留上一次成功网站。没有匹配管理标记的目录不会被覆盖。","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"key":"NYZDmaY220"}],"key":"Rfc5o49Xj2"},{"type":"paragraph","position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"children":[{"type":"text","value":"Build 成功后，结果面板会显示本地 127.0.0.1 网站地址和 Open Website 按钮；该地址在 LanCarbon 运行期间有效。点击 Open Build Folder 可查看导出源文件和 _build/html，关闭 LanCarbon 或 PowerShell 后这些文件仍会保留。","position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"key":"TopSQbFh0J"}],"key":"kPfID7ArKj"},{"type":"comment","value":" lancarbon-offline-theme-runtime-1 ","key":"GDFu8e5riW"},{"type":"heading","depth":3,"position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"children":[{"type":"text","value":"Bundled Book Theme","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"key":"qaq6s5Wv9y"}],"identifier":"bundled-book-theme","label":"Bundled Book Theme","html_id":"bundled-book-theme","implicit":true,"key":"BzrnI6kn62"},{"type":"paragraph","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"children":[{"type":"text","value":"LanCarbon includes a verified official Book Theme 